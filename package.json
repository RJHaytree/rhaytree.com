{
  "name": "personal",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "vite build",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-query-devtools": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.92.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/intent": "^0.5.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  }
}
